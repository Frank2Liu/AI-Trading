[Unit]
Description=AI Trader Backend Service
After=network.target

[Service]
WorkingDirectory=/opt/ai-trader/service/server
Environment=PATH=/opt/ai-trader/service/server/.venv/bin:/usr/bin:/bin
Environment=DATABASE_URL=postgresql://ai_trader_user:strong_password@localhost:5432/ai_trader
Environment=REDIS_URL=redis://localhost:6379/0
Environment=SECRET_KEY=change-this-secret
ExecStart=/opt/ai-trader/service/server/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
